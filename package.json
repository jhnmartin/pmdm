{
  "name": "pmdm",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @pmdm/backend --filter @pmdm/web run dev",
    "dev:web": "pnpm --filter @pmdm/web dev",
    "dev:backend": "pnpm --filter @pmdm/backend dev",
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "convex": "pnpm --filter @pmdm/backend exec convex"
  }
}
